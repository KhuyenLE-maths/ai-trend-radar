# ==== BẮT BUỘC ====
# GitHub Personal Access Token (classic, chỉ cần scope public_repo hoặc không scope nào)
# Tạo tại: https://github.com/settings/tokens — không có token thì rate limit chỉ 60 req/h, crawl sẽ fail.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Token bảo vệ các endpoint /api/v1/admin/* — ĐỔI GIÁ TRỊ NÀY!
ADMIN_TOKEN=doi-mat-khau-nay-ngay

# ==== TUỲ CHỌN ====
# Mật khẩu Postgres (mặc định: radar)
POSTGRES_PASSWORD=radar

# Cổng API trên máy (mặc định 8001, vì 8000 thường đã có dịch vụ khác dùng)
API_PORT=8001

# API key cho AI Summary (bỏ trống = bỏ qua bước summary, mọi thứ khác vẫn chạy)
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-4-5
SUMMARY_DAILY_LIMIT=20

# Slack incoming webhook để nhận thông báo pipeline (bỏ trống = không gửi)
SLACK_WEBHOOK_URL=

# Lịch chạy pipeline (cron, giờ UTC). 0 2 * * * = 02:00 UTC = 09:00 giờ VN
PIPELINE_CRON=0 2 * * *

# Tham số crawl — giảm xuống để chạy thử nhanh, tăng lên khi chạy thật
DISCOVER_PAGES_PER_QUERY=2
DISCOVER_MIN_STARS=50
AI_FILTER_THRESHOLD=3.0
